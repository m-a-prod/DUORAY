msgstr "Test speed of all"

msgid "Подмена HWID"
msgstr "HWID spoofing"

msgid "Точно удалить?"
msgstr "Really remove?"

msgid "Удалить подписку"
msgstr "Remove subscription"

msgid "Выберите сервер из списка ниже, затем нажмите «Подключиться»."
msgstr "Choose a server from the list below, then press “Connect”."

msgid "Пока нет серверов"
msgstr "No servers yet"

msgid "Нажмите «+» рядом с «Подписки» и добавьте ссылку на сервер."
msgstr "Press “+” next to “Subscriptions” and add a server link."

